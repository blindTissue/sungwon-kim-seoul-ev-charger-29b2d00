# Copy to .env (cp .env.example .env). Every variable is optional; the defaults run fully on mocks.

# ---- Server -----------------------------------------------------------------
# host port published by docker compose, and the server port when run directly
PORT=3000
HOST=0.0.0.0
# SQLite file for the mock store. ":memory:" (default) reseeds on every start.
DB_PATH=:memory:
# Comma-separated allowed origins for CORS, or * (default).
CORS_ORIGIN=*

# ---- Provider selection (kakao | mock) -------------------------------------
# kakao = Kakao Mobility Directions, mock = haversine x 1.3 at 22 km/h
ROUTING_PROVIDER=mock
# kakao = Kakao Local keyword search, mock = ~35 fixed Seoul landmarks
PLACES_PROVIDER=mock
# kakao = Kakao Maps JS SDK, mock = Leaflet + OpenStreetMap tiles
MAP_PROVIDER=mock

# ---- Kakao keys (backend only; never put REST keys in the app) --------------
# Aliases are also accepted (used when the *_KEY name is empty), matching the
# Cursor Cloud Agent secret names: KAKAO_REST_API -> KAKAO_REST_API_KEY,
# KAKAO_JS -> KAKAO_JS_KEY. Set the PROVIDER vars above to "kakao" to use them.
# Kakao Developers "REST API key" (Local API; also used for Mobility if the next one is empty)
KAKAO_REST_API_KEY=
# optional separate key for Kakao Mobility Directions
KAKAO_MOBILITY_API_KEY=
# Kakao Maps "JavaScript key"; register this server's URL as a Web platform domain
KAKAO_JS_KEY=

# ---- Availability simulator (mock backend only) -----------------------------
SIM_ENABLED=true
# seeded RNG for reproducible runs
SIM_SEED=42
# simulated-time multiplier, e.g. 10 for demos
SIM_SPEED=1
# real time between simulator ticks (spec: 30 s)
SIM_TICK_MS=30000

# ---- Demo / debug endpoints (/debug/*) --------------------------------------
# set to false outside demos
DEBUG_ENDPOINTS=true
